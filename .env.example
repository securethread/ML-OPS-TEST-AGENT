# Copy to .env and fill in. Everything has a safe-ish default; the only thing
# you really need for the full experience is an OpenRouter API key.

# --- OpenRouter (get a key at https://openrouter.ai/keys) ---
# Leave blank to run the deterministic offline MOCK agent instead.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Recommended model: cheap, good tool-calling, compliant enough that the
# injected attacks actually fire. Alternatives:
#   anthropic/claude-3.5-haiku
#   meta-llama/llama-3.3-70b-instruct:free   (free tier)
#   google/gemini-flash-1.5
LLM_MODEL=openai/gpt-4o-mini

# --- Lab behaviour ---
DEFAULT_CUSTOMER_ID=CUST-1001
MAX_TOOL_ITERATIONS=15

# Enable the real shell tool (excessive agency -> RCE). OFF by default.
# Only turn on inside a throwaway container.
LAB_ENABLE_SHELL=0

# Naive guardrail (a defense to bypass with synonyms). 1=on (harder), 0=off (easy tier).
LAB_ENABLE_GUARDRAIL=1

# Lab-public login password and the loopback SSRF service port.
LAB_PASSWORD=labpass
SSRF_PORT=8077

# --- Web server ---
HOST=127.0.0.1
PORT=8000
